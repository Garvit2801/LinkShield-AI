# Local demo: works without Google credentials, shows evidence limitations honestly.
DISABLE_GOOGLE=1
AUTH_REQUIRED=0
ENABLE_FIRESTORE=0
# Set these after authenticating with gcloud for real Google Cloud lookups:
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
# Docker Compose preconfigures these; never expose the worker publicly.
SANDBOX_URL=http://sandbox:8090
SANDBOX_TOKEN=replace-with-a-long-random-secret
# Sign in with Google: an OAuth web client ID whose authorised JavaScript origins include the site URL.
# Without it the site works for guests only.
GOOGLE_CLIENT_ID=
# Keep history, preferences and Shieldy notes in BigQuery (deploy-gcp.sh creates the dataset), e.g. my-project.linkshield
BQ_DATASET=
BQ_LOCATION=asia-south1
# Optional Google Cloud integrations, provisioned by Terraform
BQ_SCAN_TABLE=
PUBSUB_TOPIC=
BQ_TABLE=
# Known-malware lookups. Free key from virustotal.com; only a file's fingerprint is ever sent.
VIRUSTOTAL_API_KEY=
# Telegram bot (create one with @BotFather). The webhook secret is any long random string you choose.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# WhatsApp bot (Meta Cloud API; needs a WhatsApp Business account).
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_DISPLAY_NUMBER=
